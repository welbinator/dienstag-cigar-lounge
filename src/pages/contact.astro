---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Layout title="Contact — Dienstag Cigar Lounge" active="contact" description="Get in touch with Dienstag Cigar Lounge, 680 Mead Drive Suite 5, North Liberty, Iowa.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow rise">Contact</p>
      <h1 class="rise">Come say hello.</h1>
      <p class="lead rise">Questions about membership, lockers, or when the doors open? Send a note and we'll get right back to you.</p>
    </div>
  </section>

  <section class="contact-body">
    <div class="wrap contact-grid">
      <div class="rise">
        <form class="form" name="contact" method="POST" action="#" data-form>
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="phone">Phone <span class="opt">(optional)</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" />
          </div>
          <div class="field">
            <label for="interest">I'm interested in</label>
            <select id="interest" name="interest">
              <option>Membership &amp; lockers</option>
              <option>Visiting the lounge</option>
              <option>Events &amp; private bookings</option>
              <option>Something else</option>
            </select>
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="4" required></textarea>
          </div>
          <button class="btn btn-solid" type="submit">Send Message</button>
          <p class="form-note muted" data-form-note></p>
        </form>
      </div>

      <aside class="rise info">
        <div class="card">
          <h3>Visit</h3>
          <p>680 Mead Drive, Suite 5<br />North Liberty, Iowa</p>
          <p class="muted">Inside WineStyles — full bar on site.</p>
        </div>
        <div class="card">
          <h3>Hours</h3>
          <p>Opening soon. Send us a note and we'll make sure you're the first to hear when we're pouring.</p>
        </div>
        <div class="card">
          <h3>Membership</h3>
          <p>Monthly membership with a personal cigar locker. Ask us for current pricing and availability.</p>
        </div>
      </aside>
    </div>
  </section>

  <style>
    .page-head { padding-top: 5rem; padding-bottom: 1rem; }
    .page-head h1 { margin: 0.6rem 0 1rem; }
    .lead { font-size: 1.15rem; max-width: 50ch; color: var(--cream); opacity: 0.9; }
    .contact-body { padding-top: 2rem; }
    .contact-grid { display: grid; grid-template-columns: 1.3fr 0.8fr; gap: 3rem; align-items: start; }
    .form { display: flex; flex-direction: column; gap: 1.1rem; }
    .field { display: flex; flex-direction: column; gap: 0.4rem; }
    label { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--cream-dim); }
    .opt { text-transform: none; letter-spacing: 0; opacity: 0.6; }
    input, select, textarea {
      background: var(--espresso-2); border: 1px solid var(--walnut); border-radius: var(--pill);
      color: var(--cream); font-family: var(--font-body); font-size: 0.95rem; padding: 0.8em 1.2em;
    }
    textarea { border-radius: var(--card); resize: vertical; }
    input:focus, select:focus, textarea:focus { outline: none; border-color: var(--gold); }
    .form .btn { align-self: flex-start; margin-top: 0.5rem; }
    .form-note { font-size: 0.85rem; }
    .info { display: flex; flex-direction: column; gap: var(--gap); }
    .info h3 { margin-bottom: 0.5rem; }
    @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; } }
  </style>

  <script>
    // Placeholder submit handler — real backend wired at deploy (Turnstile + form endpoint).
    const form = document.querySelector("[data-form]");
    const note = document.querySelector("[data-form-note]");
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      if (note) note.textContent = "Thanks — we'll be in touch shortly. (Form delivery is being finalized.)";
    });
  </script>
</Layout>
